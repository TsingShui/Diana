[
  {"id": "conditional-observation-and-break", "method": "advanceThenStop", "values": [-2, 0, 3, 10], "limit": 4, "fault": false,
   "expected": ["return:3", 3, 2798528, 3, [-2, 0, 3, 10]]},
  {"id": "exhaustion-past-zero", "method": "advanceThenStop", "values": [0, 2, 1], "limit": 2, "fault": false,
   "expected": ["return:17", 17, 2832161, 1, [0, 2, 1]]},
  {"id": "effect-before-supplied-fault", "method": "advanceThenStop", "values": [-2, 3, 10], "limit": 4, "fault": true,
   "expected": ["supplied-fault", 17, 2798497, 3, [-2, 3, 10]]},
  {"id": "break-bypasses-observation-and-fault", "method": "advanceThenStop", "values": [0, 10, 1], "limit": 4, "fault": true,
   "expected": ["return:1", 1, 3, -99, [0, 10, 1]]},
  {"id": "null-fault-before-effects", "method": "advanceThenStop", "values": null, "limit": 4, "fault": false,
   "expected": ["null-array-fault", 17, 3, -99, null]},
  {"id": "empty-loop-retains-state", "method": "advanceThenStop", "values": [], "limit": 4, "fault": false,
   "expected": ["return:17", 17, 3, -99, []]},
  {"id": "zero-revisits-same-index-before-break", "method": "holdOnZero", "values": [0, 2, -1], "limit": 0, "fault": false,
   "expected": ["return:2", 2, 2801379, 2, [1, 2, -1]]},
  {"id": "revisit-two-zeroes-before-exhaustion", "method": "holdOnZero", "values": [0, 0], "limit": 0, "fault": false,
   "expected": ["return:17", 17, 2801378, 1, [1, 1]]},
  {"id": "negative-break-leaves-unvisited-zero", "method": "holdOnZero", "values": [-1, 0], "limit": 0, "fault": false,
   "expected": ["return:0", 0, 3, -99, [-1, 0]]},
  {"id": "observation-uses-new-index", "method": "observeAfterAdvance", "values": [2, 0, 7, -1], "limit": 0, "fault": false,
   "expected": ["return:3", 3, 2832198, 7, [2, 0, 7, -1]]},
  {"id": "zero-skips-effect-after-advance", "method": "observeAfterAdvance", "values": [0, 4], "limit": 0, "fault": false,
   "expected": ["return:17", 17, 2980, 4, [0, 4]]},
  {"id": "new-index-triggers-original-fault", "method": "observeAfterAdvance", "values": [2, 0, -1], "limit": 0, "fault": true,
   "expected": ["supplied-fault", 17, 2947, 2, [2, 0, -1]]}
